---
// Stripe Buy Button — no backend required, works on static hosting.
//
// Steps to get your values from the Stripe Dashboard:
//   1. Go to https://dashboard.stripe.com/payment-links and create a Payment Link
//      (or use an existing one) with the donation amount(s) you want.
//   2. On the Payment Link detail page, click "Buy button" → copy the two values below.
//
// The publishable key is public by design (it ships to every visitor's browser).
import { Heart, X } from '@lucide/astro';

const BUY_BUTTON_ID   = 'buy_btn_1TMpFz1lDmBh2mHNC0s56T4N';
const PUBLISHABLE_KEY = 'pk_live_51Ro7J91lDmBh2mHNs4Sd3rxEm2fjSnXUZ1hZyuavAgJ8djxnhI6vO1qJ3E1FCN7oT0HW8RZZghjLNgz4gTEaB8ac00ZGt5sxeR';
---

<dialog id="donation-modal" aria-labelledby="donation-title" class="donation-dialog m-auto w-[calc(100%-2rem)] max-w-sm p-0">
	<div class="relative p-8 flex flex-col items-center gap-6">
		<button
			id="donation-close"
			type="button"
			class="absolute top-3 right-3 p-2 text-slate hover:text-arctic transition-colors"
			aria-label="Close"
		>
			<X class="w-5 h-5" aria-hidden="true" />
		</button>

		<div class="flex flex-col items-center gap-2 text-center">
			<Heart class="w-8 h-8 text-arctic fill-current" aria-hidden="true" />
			<h2 id="donation-title" class="text-xl font-semibold text-arctic">Support my work</h2>
			<p class="text-sm text-ink">If you enjoy my projects, a small donation helps me keep building them.</p>
		</div>

		<!-- Stripe Buy Button widget (loaded on demand by the script below) -->
		<div id="stripe-widget-mount" class="w-full min-h-12 flex items-center justify-center" aria-live="polite">
			<p data-status class="text-sm text-slate">Loading payment options…</p>
		</div>
	</div>
</dialog>

<style>
	.donation-dialog {
		border: 1px solid rgba(190, 197, 215, 0.7);
		background: #fff;
		box-shadow: 0 24px 64px rgba(20, 42, 80, 0.25);
	}
	.donation-dialog::backdrop {
		background: rgba(20, 38, 72, 0.5);
		backdrop-filter: blur(4px);
	}
	.donation-dialog[open] {
		animation: dialog-in 0.3s var(--ease-out-expo);
	}
	@keyframes dialog-in {
		from { opacity: 0; transform: translateY(12px) scale(0.98); }
		to   { opacity: 1; transform: none; }
	}
</style>

<script define:vars={{ BUY_BUTTON_ID, PUBLISHABLE_KEY }}>
	const modal    = document.getElementById('donation-modal');
	const closeBtn = document.getElementById('donation-close');
	const mount    = document.getElementById('stripe-widget-mount');
	const status   = mount.querySelector('[data-status]');

	let widgetLoaded = false;

	function loadStripeWidget() {
		if (widgetLoaded) return;
		widgetLoaded = true;

		const script = document.createElement('script');
		script.src   = 'https://js.stripe.com/v3/buy-button.js';
		script.async = true;
		script.onload = () => {
			const widget = document.createElement('stripe-buy-button');
			widget.setAttribute('buy-button-id', BUY_BUTTON_ID);
			widget.setAttribute('publishable-key', PUBLISHABLE_KEY);
			status.remove();
			mount.appendChild(widget);
		};
		script.onerror = () => {
			widgetLoaded = false;
			script.remove();
			status.textContent = 'Payment options could not load. Check your connection or ad blocker, then try again.';
		};
		document.head.appendChild(script);
	}

	function openModal() {
		loadStripeWidget();
		modal.showModal();
	}

	document.querySelectorAll('[data-donate-trigger]').forEach((el) => {
		el.addEventListener('click', openModal);
	});

	closeBtn.addEventListener('click', () => modal.close());
	// Click on the backdrop (outside the panel) closes the dialog
	modal.addEventListener('click', (e) => {
		if (e.target === modal) modal.close();
	});
</script>
