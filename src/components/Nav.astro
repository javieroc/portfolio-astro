---
import { Heart } from '@lucide/astro';
import DonationButton from './DonationButton.astro';

const links = [
	{ href: '/portfolio-astro/#projects', id: 'projects', label: 'Projects' },
	{ href: '/portfolio-astro/#about', id: 'about', label: 'About' },
	{ href: '/portfolio-astro/#skills', id: 'skills', label: 'Skills' },
	{ href: '/portfolio-astro/#contact', id: 'contact', label: 'Contact' },
];
---

<header class="fixed top-0 w-full z-50 bg-frost/95 backdrop-blur-md border-b border-mist/50">
	<nav class="container mx-auto px-4 sm:px-6 py-3.5" aria-label="Main">
		<div class="flex justify-between items-center">
			<a href="/portfolio-astro/" class="font-cinzel text-base sm:text-xl tracking-[0.12em] sm:tracking-widest text-arctic font-semibold uppercase">
				Javier Ocampo
			</a>
			<div class="hidden md:flex items-center gap-8 text-sm tracking-wide uppercase">
				{links.map((l) => (
					<a href={l.href} data-section={l.id} class="nav-link">{l.label}</a>
				))}
				<button
					type="button"
					data-donate-trigger
					class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-sm font-medium tracking-wide border border-arctic text-arctic hover:bg-arctic hover:text-white transition-colors duration-200"
				>
					<Heart class="w-3.5 h-3.5 fill-current" aria-hidden="true" />
					Donate
				</button>
			</div>
			<button
				id="menu-btn"
				type="button"
				class="md:hidden -mr-2 p-2 text-arctic"
				aria-label="Menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path class="line top" stroke-linecap="round" stroke-width="2" d="M4 6h16"></path>
					<path class="line middle" stroke-linecap="round" stroke-width="2" d="M4 12h16"></path>
					<path class="line bottom" stroke-linecap="round" stroke-width="2" d="M4 18h16"></path>
				</svg>
			</button>
		</div>
	</nav>
	<div id="mobile-menu" class="md:hidden overflow-hidden transition-[max-height] duration-300 ease-in-out" style="max-height: 0px;" inert>
		{links.map((l) => (
			<a href={l.href} class="block py-3 px-6 text-sm text-slate hover:text-arctic hover:bg-mist/20 transition-colors uppercase tracking-wide">{l.label}</a>
		))}
		<button
			type="button"
			data-donate-trigger
			class="flex w-full items-center gap-2 py-3 px-6 text-sm text-arctic hover:text-white hover:bg-arctic transition-colors uppercase tracking-wide"
		>
			<Heart class="w-3.5 h-3.5 fill-current" aria-hidden="true" />
			Donate
		</button>
	</div>
</header>

<DonationButton />

<style>
	#menu-btn .line {
		transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
		transform-origin: center;
	}
	#menu-btn[aria-expanded='true'] .top { transform: translateY(6px) rotate(45deg); }
	#menu-btn[aria-expanded='true'] .middle { opacity: 0; }
	#menu-btn[aria-expanded='true'] .bottom { transform: translateY(-6px) rotate(-45deg); }

	.nav-link {
		position: relative;
		color: var(--color-slate);
		transition: color 0.25s ease;
	}
	.nav-link::after {
		content: '';
		position: absolute;
		bottom: -3px;
		left: 0;
		width: 0;
		height: 1.5px;
		background: var(--color-arctic);
		transition: width 0.35s var(--ease-out-expo);
	}
	.nav-link:hover,
	.nav-link[aria-current='true'] {
		color: var(--color-arctic);
	}
	.nav-link:hover::after,
	.nav-link[aria-current='true']::after {
		width: 100%;
	}
</style>

<script>
	// ── Mobile menu toggle ──────────────────────────────────────────
	const menuBtn = document.getElementById('menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');

	function setMenu(open: boolean) {
		if (!menuBtn || !mobileMenu) return;
		menuBtn.setAttribute('aria-expanded', String(open));
		mobileMenu.style.maxHeight = open ? `${mobileMenu.scrollHeight}px` : '0px';
		mobileMenu.inert = !open;
	}

	menuBtn?.addEventListener('click', () => {
		setMenu(menuBtn.getAttribute('aria-expanded') !== 'true');
	});
	mobileMenu?.querySelectorAll('a, button').forEach((el) => el.addEventListener('click', () => setMenu(false)));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
			setMenu(false);
			menuBtn.focus();
		}
	});

	// ── Active section highlighting (home page only) ────────────────
	const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
	const sectionObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				navLinks.forEach((link) => {
					if (link.dataset.section === entry.target.id) link.setAttribute('aria-current', 'true');
					else link.removeAttribute('aria-current');
				});
			});
		},
		{ rootMargin: '-30% 0px -65% 0px', threshold: 0 }
	);
	document.querySelectorAll('section[id]').forEach((s) => sectionObserver.observe(s));
</script>
