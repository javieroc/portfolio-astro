---
import { Github, Globe, Smartphone, ArrowRight } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';
import ProjectCover from './ProjectCover.astro';
import { getProjects, projectHref } from '../lib/projects';

const projects = await getProjects();
---

<section id="projects" aria-labelledby="projects-title" class="projects-section py-24 px-4 sm:px-6">
	<div class="container mx-auto">
		<SectionHeading id="projects-title" title="Projects" />

		<ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto stagger" role="list">
			{projects.map((project) => {
				const { title, description, stack, github, demo, apk } = project.data;
				const href = projectHref(project.slug);
				return (
					<li class="project-card group relative flex flex-col overflow-hidden">
						<div class="relative aspect-[16/10] overflow-hidden bg-frost-deep">
							<ProjectCover
								src={project.imageSrc}
								title={title}
								class="transition-transform duration-700 ease-out group-hover:scale-[1.04]"
							/>
						</div>

						<div class="flex flex-col flex-1 p-5">
							<h3 class="font-cinzel font-bold text-arctic text-base tracking-wide mb-2">
								<a href={href} class="card-link">
									{title}
								</a>
							</h3>
							<p class="text-sm text-ink/90 leading-relaxed mb-4 flex-1 line-clamp-3">
								{description}
							</p>
							<ul class="flex flex-wrap gap-1.5 mb-5" role="list" aria-label="Tech stack">
								{stack.map((tech) => (
									<li class="tag text-xs px-2 py-0.5">{tech}</li>
								))}
							</ul>

							<div class="relative z-10 flex flex-wrap items-center gap-x-4 gap-y-2 pt-4 border-t border-mist/50 text-sm">
								{github && (
									<a href={github} target="_blank" rel="noopener noreferrer" class="card-action">
										<Github class="w-4 h-4" aria-hidden="true" />
										Code
									</a>
								)}
								{demo && (
									<a href={demo} target="_blank" rel="noopener noreferrer" class="card-action">
										<Globe class="w-4 h-4" aria-hidden="true" />
										Demo
									</a>
								)}
								{apk && (
									<a href={apk} class="card-action">
										<Smartphone class="w-4 h-4" aria-hidden="true" />
										APK
									</a>
								)}
								<span class="ml-auto inline-flex items-center gap-1 text-arctic font-medium" aria-hidden="true">
									Details
									<ArrowRight class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
								</span>
							</div>
						</div>
					</li>
				);
			})}
		</ul>
	</div>
</section>

<style>
	.projects-section {
		background: linear-gradient(155deg, #EDF0F8 0%, var(--color-frost-deep) 60%, #EDF0F8 100%);
	}

	.project-card {
		background: #fff;
		border: 1px solid rgba(190, 197, 215, 0.6);
		box-shadow: 0 4px 24px rgba(52, 89, 136, 0.07);
		transition:
			transform 0.35s var(--ease-out-expo),
			box-shadow 0.35s var(--ease-out-expo),
			border-color 0.35s ease;
	}
	.project-card:hover,
	.project-card:focus-within {
		transform: translateY(-4px);
		border-color: rgba(117, 144, 189, 0.6);
		box-shadow:
			0 20px 50px rgba(52, 89, 136, 0.13),
			0 6px 16px rgba(52, 89, 136, 0.07);
	}

	/* Stretch the title link over the whole card; action links sit above it. */
	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.card-link:focus-visible {
		outline: none;
	}
	.project-card:has(.card-link:focus-visible) {
		outline: 2px solid var(--color-arctic);
		outline-offset: 3px;
	}

	.tag {
		background: rgba(117, 144, 189, 0.12);
		border: 1px solid rgba(117, 144, 189, 0.3);
		color: var(--color-ink);
		border-radius: 2px;
		letter-spacing: 0.02em;
	}

	.card-action {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding-block: 0.25rem;
		color: var(--color-slate);
		transition: color 0.2s ease;
	}
	.card-action:hover {
		color: var(--color-arctic);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
