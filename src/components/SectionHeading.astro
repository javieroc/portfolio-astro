---
interface Props {
	id?: string;
	title: string;
}
const { id, title } = Astro.props;
---

<h2 id={id} class="section-title reveal">{title}</h2>
<div class="section-rule reveal" aria-hidden="true">
	<!-- Horizontal sword: pommel, grip, crossguard, blade -->
	<svg width="56" height="12" viewBox="0 0 56 12" fill="currentColor">
		<circle cx="3" cy="6" r="2.2" />
		<rect x="5" y="5" width="7" height="2" />
		<rect x="12" y="1" width="2.2" height="10" rx="1" />
		<path d="M14.2 4.6h36.3L55 6l-4.5 1.4H14.2z" />
	</svg>
</div>
