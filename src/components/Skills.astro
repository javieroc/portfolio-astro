---
import { Code, Server, Braces, Database, Cloud, Globe, type AstroComponent } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';

const skills: { name: string; icon: AstroComponent; level: string }[] = [
	{ name: 'React & Next.js', icon: Code, level: 'Expert' },
	{ name: 'Node.js & NestJS', icon: Server, level: 'Expert' },
	{ name: 'TypeScript & Python', icon: Braces, level: 'Expert' },
	{ name: 'PostgreSQL & MongoDB', icon: Database, level: 'Proficient' },
	{ name: 'AWS & Docker', icon: Cloud, level: 'Proficient' },
	{ name: 'GraphQL & REST APIs', icon: Globe, level: 'Proficient' },
];
---

<section id="skills" aria-labelledby="skills-title" class="py-24 px-4 sm:px-6 bg-white/50">
	<div class="container mx-auto">
		<SectionHeading id="skills-title" title="Tech Stack" />

		<ul class="skills-list grid md:grid-cols-2 gap-x-14 max-w-3xl mx-auto stagger" role="list">
			{skills.map((skill) => (
				<li class="flex items-center gap-4 py-4 border-b border-mist/60">
					<skill.icon class="w-5 h-5 text-glacier flex-shrink-0" aria-hidden="true" />
					<span class="font-cinzel font-semibold text-arctic tracking-wide">{skill.name}</span>
					<span class="ml-auto text-sm text-slate">{skill.level}</span>
				</li>
			))}
		</ul>
	</div>
</section>
